      "transaction": "无",
      "concurrency": "同 session 取消旧任务"
    },
    {
      "id": "IFC-2",
      "provider": "DuplicateFinderService",
      "consumers": [
        "useDuplicates"
      ],
      "input": "DuplicateScanRequest",
      "output": "{taskId} + DuplicateScanProgress 流（终态 groups）",
      "preconditions": "canList+canStat",
      "postconditions": "groups ≤5000 + truncated",
      "invariants": "分组键=全量哈希；浪费空间降序",
      "errors": "遍历连续失败→failed",
      "data_ownership": "主进程",
      "transaction": "无",
      "concurrency": "顺序遍历"
    },
    {
      "id": "IFC-3",
      "provider": "GrepService",
      "consumers": [
        "useGrepSearch"
      ],
      "input": "GrepRequest",
      "output": "{taskId} + GrepProgress 批量流",
      "preconditions": "canGrepContent",
      "postconditions": "matchCount 单调；truncated 语义",
      "invariants": "iOS 直接 failed；行文本 ≤400 字",
      "errors": "rg exit 2 / 远端 exit>1 → failed",
      "data_ownership": "主进程",
      "transaction": "无",
      "concurrency": "子进程/远端单飞行"
    },
    {
      "id": "IFC-4",
      "provider": "preview store + Router + TextContent",
