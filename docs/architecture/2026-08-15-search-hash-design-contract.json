      "preconditions": "initialLine>0",
      "postconditions": "一次性 reveal+选中+聚焦",
      "invariants": "initialLine 存在时强制 text 类型",
      "errors": "行号超界钳制到末行",
      "data_ownership": "renderer",
      "transaction": "无",
