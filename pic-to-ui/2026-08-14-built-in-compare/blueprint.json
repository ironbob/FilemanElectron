  "key_dimensions": [
    { "id": "D01", "what": "左右来源栏与列表数据区", "ratio_note": "左右两侧保持 1:1 镜像宽度，中央状态桥接区明显窄于任一文件信息侧；来自已确认文本结构，无像素基线。" },
    { "id": "D02", "what": "主结果区与上下命令区", "ratio_note": "可滚动结果列表占据绝大部分垂直空间，标签、工具栏、来源头和状态栏均为紧凑单行或双行区；来自已确认文本结构，无像素基线。" },
    { "id": "D03", "what": "名称、大小、修改时间列", "ratio_note": "每侧名称列最宽，大小列最窄，修改时间列居中；具体比例需要在现有窗口适配中验证。" },
    { "id": "D04", "what": "验证进度带", "ratio_note": "嵌入命令区并保持单行进度信息，不挤压左右来源栏；宽度优先保障完成数、百分比和取消入口可见。" },
    { "id": "D05", "what": "复制确认浮层", "ratio_note": "居中覆盖主列表，宽度约为工作区的一半至三分之二，背景列表仍可辨识但不可交互；具体形式在模态框或系统 Sheet 中择一。" },
    { "id": "D06", "what": "结果行密度", "ratio_note": "采用桌面文件管理器的紧凑行高，同时容纳文件名主行和中央状态文字；需以现有字号与可点击面积共同校准。" }
