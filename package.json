{
  "name": "fileman-electron",
  "version": "0.1.0",
  "description": "Cross-device file manager for macOS",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "E2E_PORT=4173 electron-vite dev --rendererOnly",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:log-analysis": "esbuild tests/logAnalysis.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/logAnalysis.test.cjs --log-level=warning && node node_modules/.tmp/logAnalysis.test.cjs",
    "test:filter-gaps": "esbuild tests/filterGaps.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/filterGaps.test.cjs --log-level=warning && node node_modules/.tmp/filterGaps.test.cjs",
    "test:relative-path": "esbuild tests/relativePath.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/relativePath.test.cjs --log-level=warning && node node_modules/.tmp/relativePath.test.cjs",
    "test:git-parse": "esbuild tests/gitStatusParse.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/gitStatusParse.test.cjs --log-level=warning && node node_modules/.tmp/gitStatusParse.test.cjs",
    "test:fuzzy-match": "esbuild tests/fuzzyMatch.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/fuzzyMatch.test.cjs --log-level=warning && node node_modules/.tmp/fuzzyMatch.test.cjs",
    "test:grep-parse": "esbuild tests/grepParsing.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/grepParsing.test.cjs --log-level=warning && node node_modules/.tmp/grepParsing.test.cjs",
    "test:squarify": "esbuild tests/squarify.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/squarify.test.cjs --log-level=warning && node node_modules/.tmp/squarify.test.cjs",
    "test:hex-viewport": "esbuild tests/hexViewport.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/hexViewport.test.cjs --log-level=warning && node node_modules/.tmp/hexViewport.test.cjs",
    "test:hex-cursor": "esbuild tests/hexCursor.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/hexCursor.test.cjs --log-level=warning && node node_modules/.tmp/hexCursor.test.cjs",
    "test:hex-edit-journal": "esbuild tests/hexEditJournal.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/hexEditJournal.test.cjs --log-level=warning && node node_modules/.tmp/hexEditJournal.test.cjs",
    "test:hex-search": "esbuild tests/hexSearch.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/hexSearch.test.cjs --log-level=warning && node node_modules/.tmp/hexSearch.test.cjs",
    "test:hex-window-cache": "esbuild tests/hexWindowCache.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/hexWindowCache.test.cjs --log-level=warning && node node_modules/.tmp/hexWindowCache.test.cjs",
    "test:hex-format": "esbuild tests/hexFormat.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/hexFormat.test.cjs --log-level=warning && node node_modules/.tmp/hexFormat.test.cjs",
    "test:json-utils": "esbuild tests/jsonUtils.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/jsonUtils.test.cjs --log-level=warning && node node_modules/.tmp/jsonUtils.test.cjs",
    "test:permissions": "esbuild tests/permissionsRoundtrip.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/permissionsRoundtrip.test.cjs --log-level=warning && node node_modules/.tmp/permissionsRoundtrip.test.cjs",
    "test:crop-geometry": "esbuild tests/cropGeometry.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/cropGeometry.test.cjs --log-level=warning && node node_modules/.tmp/cropGeometry.test.cjs",
    "test:batch-rename-pattern": "esbuild tests/batchRenamePattern.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/batchRenamePattern.test.cjs --log-level=warning && node node_modules/.tmp/batchRenamePattern.test.cjs",
    "test:image-edit-naming": "esbuild tests/imageEditNaming.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/imageEditNaming.test.cjs --log-level=warning && node node_modules/.tmp/imageEditNaming.test.cjs",
    "test:annotation-shapes": "esbuild tests/annotationShapes.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/annotationShapes.test.cjs --log-level=warning && node node_modules/.tmp/annotationShapes.test.cjs",
    "test:ohos-parse": "esbuild tests/ohosParsing.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/ohosParsing.test.cjs --log-level=warning && node node_modules/.tmp/ohosParsing.test.cjs",
    "test:i18n": "esbuild tests/i18nCatalog.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/i18nCatalog.test.cjs --log-level=warning --alias:@shared=./shared && node node_modules/.tmp/i18nCatalog.test.cjs",
    "test:tab-titles": "esbuild tests/tabTitles.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/tabTitles.test.cjs --log-level=warning --alias:@shared=./shared && node node_modules/.tmp/tabTitles.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "icon": "node scripts/generate-icon.mjs",
    "build:native": "FILEMAN_IOS_BUILD_REQUIRED=1 node scripts/build-ios-addon.cjs",
    "build:ios": "npm run build:native && bash scripts/bundle-ios-dylibs.sh",
    "postinstall": "node scripts/build-ios-addon.cjs",
    "dist:mac": "bash scripts/build-dmg.sh",
    "dist:mac:fast": "bash scripts/build-dmg.sh --no-build"
  },
  "dependencies": {
    "@alenaksu/json-viewer": "^2.1.2",
    "@devicefarmer/adbkit": "^3.3.9",
    "@marsaud/smb2": "^0.18.0",
    "dompurify": "^3.3.3",
    "electron-store": "^8.1.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.2",
    "ffmpeg-static": "^5.3.0",
    "fs-extra": "^11.2.0",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.4",
    "marked-highlight": "^2.2.3",
    "mediainfo.js": "^0.3.7",
    "mon": "^0.0.8",
    "monaco-editor": "0.44.0",
    "pdfjs-dist": "^5.5.207",
    "pinia": "^2.1.7",
    "pinyin-pro": "^3.29.1",
    "sharp": "^0.34.5",
    "ssh2": "^1.17.0",
    "vue": "^3.4.21",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.3.0",
    "vue-virtual-scroller": "^2.0.0-beta.8",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@playwright/test": "^1.62.1",
    "@types/bluebird": "^3.5.42",
    "@types/dompurify": "^3.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.24",
    "@types/sharp": "^0.31.1",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.18",
    "electron": "^29.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^2.0.0",
    "node-addon-api": "^8.9.1",
    "node-gyp": "^12.4.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.5",
    "vue-tsc": "^2.0.6"
  }
}
