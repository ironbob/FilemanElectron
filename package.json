{
  "name": "fileman-electron",
  "version": "0.1.0",
  "description": "Cross-device file manager for macOS",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit",
    "icon": "node scripts/generate-icon.mjs",
    "build:native": "FILEMAN_IOS_BUILD_REQUIRED=1 node scripts/build-ios-addon.cjs",
    "build:ios": "npm run build:native && bash scripts/bundle-ios-dylibs.sh",
    "postinstall": "node scripts/build-ios-addon.cjs",
    "dist:mac": "bash scripts/build-dmg.sh",
    "dist:mac:fast": "bash scripts/build-dmg.sh --no-build"
  },
  "dependencies": {
    "@alenaksu/json-viewer": "^2.1.2",
    "@devicefarmer/adbkit": "^3.3.9",
    "@marsaud/smb2": "^0.18.0",
    "dompurify": "^3.3.3",
    "electron-store": "^8.1.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.2",
    "ffmpeg-static": "^5.3.0",
    "fs-extra": "^11.2.0",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.4",
    "marked-highlight": "^2.2.3",
    "mon": "^0.0.8",
    "monaco-editor": "0.44.0",
    "pdfjs-dist": "^5.5.207",
    "pinia": "^2.1.7",
    "pinyin-pro": "^3.29.1",
    "sharp": "^0.34.5",
    "ssh2": "^1.17.0",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "vue-virtual-scroller": "^2.0.0-beta.8",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@types/bluebird": "^3.5.42",
    "@types/dompurify": "^3.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.24",
    "@types/sharp": "^0.31.1",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.18",
    "electron": "^29.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^2.0.0",
    "node-addon-api": "^8.9.1",
    "node-gyp": "^12.4.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.5",
    "vue-tsc": "^2.0.6"
  }
}
